# Sao chép thành ../.env (thư mục gốc của repo) và đổi giá trị. File .env không được commit.
PRESENCE_DATA_DIR=./data
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=presence-backend
MQTT_PASSWORD=doi-mat-khau-nay
MQTT_TLS=0
MQTT_CA_FILE=
MQTT_TOPIC_PREFIX=presence/v1
# Phiên MQTT bền của backend (broker giữ mẫu khi backend khởi động lại). Mỗi mã chỉ một backend chạy.
MQTT_CLIENT_ID=presence-backend
# Token thiết bị dùng khi tải gói mô hình (Authorization: Bearer ...), cách nhau bởi dấu phẩy
DEVICE_TOKENS=doi-token-thiet-bi
# Bảo vệ API quản trị/dashboard (bắt buộc khi mở ra ngoài LAN)
ADMIN_TOKEN=doi-token-quan-tri
# Khóa riêng ký gói mô hình (tạo bằng: python tools/keys.py init)
MODEL_SIGNING_KEY=./secrets/model_signing_key.pem
# Trong Docker: MODEL_SIGNING_KEY=/secrets/model_signing_key.pem
