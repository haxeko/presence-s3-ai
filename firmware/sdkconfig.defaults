# ESP32-S3-DevKitC-1 (N8 / N8R2 / N8R8), ESP-IDF v5.5.x
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# Network event handlers (IP, Wi-Fi, Ethernet) run here: 440 bytes were left of the default 2304 (measured with `mem`)
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
# Radar bytes keep arriving while flash is written (model download, NVS): UART ISR in IRAM
CONFIG_UART_ISR_IN_IRAM=y
# MQTT: TLS optional, bounded outbox
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TRANSPORT_SSL=y
CONFIG_MQTT_OUTBOX_EXPIRED_TIMEOUT_MS=60000
# HTTPS model download with the certificate bundle (public CAs); private CA: see docs/security.md
CONFIG_ESP_TLS_USING_MBEDTLS=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
# ECDSA P-256 signature check of model packages
CONFIG_MBEDTLS_ECDSA_C=y
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y
CONFIG_MBEDTLS_PEM_PARSE_C=y
# SNTP
CONFIG_LWIP_SNTP_MAX_SERVERS=1
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
