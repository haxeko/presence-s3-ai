# Copy to sdkconfig.secrets (git-ignored) and build with:
#   idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.secrets" build
# Or leave everything empty and use the serial console: config set wifi_ssid ... (stored in NVS)
CONFIG_PRESENCE_WIFI_SSID="ten-wifi"
CONFIG_PRESENCE_WIFI_PASSWORD="mat-khau-wifi"
CONFIG_PRESENCE_MQTT_URI="mqtt://192.168.1.10:1883"
# Để trống: tên đăng nhập = mã thiết bị (s3-xxxxxx), khớp ACL của Mosquitto
CONFIG_PRESENCE_MQTT_USERNAME=""
CONFIG_PRESENCE_MQTT_PASSWORD="doi-mat-khau-nay"
CONFIG_PRESENCE_SERVER_URL="http://192.168.1.10:8000"
CONFIG_PRESENCE_DEVICE_TOKEN="dan-token-thiet-bi-vao-day"
